include("@CMAKE_CURRENT_BINARY_DIR@/CPackConfig.cmake")

set(CPACK_PACKAGE_NAME "@LIBTUBUS@")
set(CPACK_PACKAGE_FILE_NAME "@LIBTUBUS@-@PROJECT_VERSION@-@CPACK_PACKAGE_RELEASE@.@CMAKE_HOST_SYSTEM_PROCESSOR@")
set(CPACK_RPM_DEBUGINFO_PACKAGE ON)
set(CPACK_RPM_DEBUGINFO_SINGLE_PACKAGE ON)
set(CPACK_RPM_PACKAGE_SUMMARY "UDP streaming library")
set(CPACK_RPM_PACKAGE_DESCRIPTION "This library implements a self obfuscated streaming transport\nprotocol based on UDP.")
set(CPACK_COMPONENTS_ALL "library_files")