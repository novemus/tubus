{
    "version": 6,
    "configurePresets": [
        {
            "name": "config-base",
            "hidden": true,
            "cacheVariables": {
                "TUBUS_SKIP_TEST_RULES": "OFF",
                "TUBUS_SKIP_INSTALL_RULES": "OFF",
                "TUBUS_SKIP_PACKAGE_RULES": "OFF"
            },
            "installDir": "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/install",
            "binaryDir": "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/build/${presetName}"
        },
        {
            "name": "relwithdebinfo-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CONFIGURATION_TYPES": "Release"
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "CMAKE_DEBUG_POSTFIX": "d"
            }
        },
        {
            "name": "static-relwithdebinfo",
            "inherits": ["config-base", "relwithdebinfo-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
            }
        },
        {
            "name": "static-release",
            "inherits": ["config-base", "release-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
            }
        },
        {
            "name": "static-debug",
            "inherits": ["config-base", "debug-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug"
            }
        },
        {
            "name": "shared-relwithdebinfo",
            "inherits": ["config-base", "relwithdebinfo-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "shared-release",
            "inherits": ["config-base", "release-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "shared-debug",
            "inherits": ["config-base", "debug-base"],
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "shared-debug",
            "displayName": "Debug",
            "configuration": "Debug",
            "configurePreset": "shared-debug"
        },
        {
            "name": "shared-release",
            "displayName": "Release",
            "configuration": "Release",
            "configurePreset": "shared-release"
        },
        {
            "name": "shared-relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "shared-relwithdebinfo"
        },
        {
            "name": "static-debug",
            "displayName": "Debug",
            "configuration": "Debug",
            "configurePreset": "static-debug"
        },
        {
            "name": "static-release",
            "displayName": "Release",
            "configuration": "Release",
            "configurePreset": "static-release"
        },
        {
            "name": "static-relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "static-relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            },
            "hidden": true
        },
        {
            "name": "static-release",
            "configurePreset": "static-release",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        },
        {
            "name": "static-relwithdebinfo",
            "configurePreset": "static-relwithdebinfo",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        },
        {
            "name": "static-debug",
            "configurePreset": "static-debug",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        },
        {
            "name": "shared-release",
            "configurePreset": "shared-release",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        },
        {
            "name": "shared-relwithdebinfo",
            "configurePreset": "shared-relwithdebinfo",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        },
        {
            "name": "shared-debug",
            "configurePreset": "shared-debug",
            "displayName": "Test",
            "description": "All project tests",
            "inherits": "test-base"
        }
    ],
    "packagePresets": [
        {
            "name": "debian-package-lib",
            "displayName": "libtubus (DEB)",
            "description": "Debian library package",
            "configurePreset": "shared-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "DEB"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_PACKAGE_DESCRIPTION_SUMMARY": "UDP streaming library",
                "CPACK_PACKAGE_DESCRIPTION": "This library implements a self obfuscated streaming transport\nprotocol based on UDP.",
                "CPACK_COMPONENTS_ALL": "library_files;lib_deb_files"
            },
            "packageName": "libtubus",
            "packageDirectory": ".."
        },
        {
            "name": "debian-package-dev",
            "displayName": "libtubus-dev (DEB)",
            "description": "Debian development package",
            "configurePreset": "static-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "DEB"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_DEBIAN_PACKAGE_DEPENDS": "libboost-dev (>= 1.74) | libboost1.81-dev, libtubus (= 1.2.4-1)",
                "CPACK_PACKAGE_DESCRIPTION_SUMMARY": "C++ development library for UDP streaming",
                "CPACK_PACKAGE_DESCRIPTION": "This library provides a C++ implementation of a self obfuscated streaming\ntransport protocol based on UDP.",
                "CPACK_COMPONENTS_ALL": "archive_files;header_files;cmake_files;dev_deb_files;dev_doc_files"
            },
            "packageName": "libtubus-dev",
            "packageDirectory": ".."
        },
        {
            "name": "rpm-package-lib",
            "displayName": "libtubus (RPM)",
            "description": "RPM library package",
            "configurePreset": "shared-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "RPM"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "configFile": "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/build/shared-relwithdebinfo/rpm-library.cmake",
            "packageName": "libtubus",
            "packageDirectory": ".."
        },
        {
            "name": "rpm-package-dev",
            "displayName": "libtubus-devel (RPM)",
            "description": "RPM development package",
            "configurePreset": "static-relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generators": [
                "RPM"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "configFile":  "${sourceDir}/out/$env{TARGET_OS}/$env{TARGET_ARCH}/build/shared-relwithdebinfo/rpm-devel.cmake",
            "packageName": "libtubus-devel",
            "packageDirectory": ".."
        },
        {
            "name": "archive",
            "displayName": "Archive (ZIP)",
            "description": "Portable ZIP archive",
            "configurePreset": "static-relwithdebinfo",
            "generators": [
                "ZIP"
            ],
            "configurations": [
                "RelWithDebInfo"
            ],
            "variables": {
                "CPACK_COMPONENTS_ALL": "runtime_files;library_files;archive_files;pdb_files;header_files;cmake_files;dev_doc_files",
                "CPACK_ARCHIVE_COMPONENT_INSTALL": "ON",
                "CPACK_COMPONENTS_ALL_IN_ONE_PACKAGE": "ON"
            },
            "packageName": "tubus",
            "packageDirectory": ".."
        }
    ],
    "workflowPresets": [
        {
            "name": "archive",
            "displayName": "Archive (ZIP)",
            "description": "Portable ZIP archive",
            "steps": [
                {
                    "type": "configure",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "test",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "package",
                    "name": "archive"
                }
            ]
        },
        {
            "name": "debian-package-lib",
            "displayName": "Package (Lib)",
            "description": "Debian library package",
            "steps": [
                {
                    "type": "configure",
                    "name": "shared-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "shared-relwithdebinfo"
                },
                {
                    "type": "test",
                    "name": "shared-relwithdebinfo"
                },
                {
                    "type": "package",
                    "name": "debian-package-lib"
                }
            ]
        },
        {
            "name": "debian-package-dev",
            "displayName": "Package (Dev)",
            "description": "Debian development package",
            "steps": [
                {
                    "type": "configure",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "test",
                    "name": "static-relwithdebinfo"
                },
                {
                    "type": "package",
                    "name": "debian-package-dev"
                }
            ]
        }
    ]
}
